{
  "name": "Send Custom Reminders Every 15 Minutes",
  "description": "Hourly safety net (was every 15 minutes): reminders are queued with OneSignal up to 26 hours ahead with an exact send time, and the app queues each one the moment it is made, so hourly is enough and uses a quarter of the function runs.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-05-29T18:11:32.547000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_custom_reminders_every_15_minutes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendCustomReminders",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendCustomReminders"
  }
}