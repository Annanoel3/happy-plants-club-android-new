{
  "name": "Post",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "content": {
      "description": "The post content (empty for a photo-only post)",
      "type": "string"
    },
    "hidden": {
      "default": false,
      "description": "Hidden by a moderator or by 3+ reports",
      "type": "boolean"
    },
    "hidden_reason": {
      "type": "string"
    },
    "image_url": {
      "description": "Optional image attached to post",
      "type": "string"
    },
    "likes_count": {
      "default": 0,
      "type": "number"
    },
    "plant_id": {
      "description": "Optional plant this post is about",
      "type": "string"
    },
    "plant_name": {
      "description": "Name of the plant if attached",
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}