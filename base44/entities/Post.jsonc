{
  "name": "Post",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "content": {
      "description": "The post content",
      "type": "string"
    },
    "image_url": {
      "description": "Optional image attached to post",
      "type": "string"
    },
    "likes_count": {
      "default": 0,
      "type": "number"
    },
    "plant_id": {
      "description": "Optional plant this post is about",
      "type": "string"
    },
    "plant_name": {
      "description": "Name of the plant if attached",
      "type": "string"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "create": {
      "data.author_email": "{{user.email}}"
    },
    "delete": {
      "data.author_email": "{{user.email}}"
    },
    "update": {
      "data.author_email": "{{user.email}}"
    }
  },
  "type": "object"
}