{
  "name": "Comment",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "content": {
      "description": "The comment content",
      "type": "string"
    },
    "hidden": {
      "default": false,
      "description": "Hidden by a moderator or by 3+ reports",
      "type": "boolean"
    },
    "hidden_reason": {
      "type": "string"
    },
    "post_id": {
      "description": "ID of the post this comment belongs to",
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}