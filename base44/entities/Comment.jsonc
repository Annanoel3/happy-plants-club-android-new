{
  "name": "Comment",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "content": {
      "description": "The comment content",
      "type": "string"
    },
    "post_id": {
      "description": "ID of the post this comment belongs to",
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "content"
  ],
  "rls": {
    "create": {
      "data.author_email": "{{user.email}}"
    },
    "delete": {
      "data.author_email": "{{user.email}}"
    },
    "update": {
      "data.author_email": "{{user.email}}"
    }
  },
  "type": "object"
}