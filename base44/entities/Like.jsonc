{
  "name": "Like",
  "properties": {
    "active": {
      "default": true,
      "description": "false after an unlike (the row stays so liking again doesn't notify the owner again)",
      "type": "boolean"
    },
    "notified": {
      "description": "The post's owner was already told about this person's like",
      "type": "boolean"
    },
    "post_id": {
      "type": "string"
    },
    "toggles": {
      "description": "Like/unlike taps on this post since toggles_since (capped per hour)",
      "type": "number"
    },
    "toggles_since": {
      "description": "Start of the current hour window for toggles (ISO time)",
      "type": "string"
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}