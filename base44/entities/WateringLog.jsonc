{
  "name": "WateringLog",
  "properties": {
    "method": {
      "enum": [
        "voice",
        "manual",
        "bulk"
      ],
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "plant_id": {
      "type": "string"
    },
    "plant_name": {
      "type": "string"
    },
    "watered_date": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "plant_id",
    "watered_date"
  ],
  "rls": {
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}