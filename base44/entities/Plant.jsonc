{
  "name": "Plant",
  "properties": {
    "care_history": {
      "description": "Care done (and rain that counted as watering): [{type, date, amount_in?}]",
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "care_instructions": {
      "properties": {
        "fertilizing": {
          "type": "string"
        },
        "growth_optimization": {
          "type": "string"
        },
        "humidity": {
          "type": "string"
        },
        "soil": {
          "type": "string"
        },
        "sunlight": {
          "type": "string"
        },
        "temperature": {
          "type": "string"
        },
        "tips": {
          "type": "string"
        },
        "watering": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "care_profile": {
      "description": "Watering profile filled in once per plant: {v, group, why, at, source, prev_every, prev_next_due, user_method, user_strict, user_interval}",
      "type": "object"
    },
    "care_schedule": {
      "description": "Plus care schedule. Each task: {on, every_days, next (date), last (date), winter_pause}",
      "properties": {
        "fertilize": {
          "type": "object"
        },
        "mist": {
          "type": "object"
        },
        "note": {
          "type": "string"
        },
        "repot": {
          "type": "object"
        },
        "rotate": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "environment": {
      "enum": [
        "Indoor",
        "Outdoor",
        "Balcony",
        "Patio",
        "Greenhouse",
        "Window Sill",
        "Office"
      ],
      "type": "string"
    },
    "gets_rain": {
      "description": "Does rain reach this plant? Unset = decided by environment (Outdoor/Patio/Balcony = yes).",
      "type": "boolean"
    },
    "growth_stage": {
      "default": "seedling",
      "enum": [
        "seedling",
        "small",
        "medium",
        "large",
        "mature"
      ],
      "type": "string"
    },
    "hybrid_name": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "last_watered": {
      "format": "date",
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "next_watering_due": {
      "format": "date",
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "pinned": {
      "default": false,
      "description": "Pinned plants appear first in the garden",
      "type": "boolean"
    },
    "plant_size": {
      "enum": [
        "Seedling",
        "Small",
        "Medium",
        "Large",
        "Mature"
      ],
      "type": "string"
    },
    "plant_type": {
      "description": "Plant category",
      "enum": [
        "Needs Attention",
        "Flowers",
        "Vegetables",
        "Herbs",
        "Trees & Shrubs",
        "Houseplants",
        "Succulents & Cacti",
        "Seedlings",
        "Perennials",
        "Annuals"
      ],
      "type": "string"
    },
    "pot_diameter_in": {
      "description": "Pot width across the top, in inches. 0 = planted in the ground. Used for water amounts and rain thresholds.",
      "type": "number"
    },
    "pot_size": {
      "enum": [
        "Much smaller than plant",
        "Slightly smaller",
        "Perfect fit",
        "Room to grow",
        "Too large"
      ],
      "type": "string"
    },
    "pot_type": {
      "enum": [
        "Plastic",
        "Terracotta/Clay",
        "Ceramic (glazed)",
        "Ceramic (unglazed)",
        "Self-watering",
        "Fabric/Grow bag"
      ],
      "type": "string"
    },
    "scientific_name": {
      "type": "string"
    },
    "status": {
      "default": "healthy",
      "enum": [
        "healthy",
        "wilted",
        "recovering"
      ],
      "type": "string"
    },
    "substrate_type": {
      "enum": [
        "Standard potting mix",
        "Cactus/succulent mix",
        "Orchid bark mix",
        "Peat-based mix",
        "Coco coir",
        "Custom mix"
      ],
      "type": "string"
    },
    "sun_exposure": {
      "enum": [
        "Full Sun (6+ hours)",
        "Partial Sun (3-6 hours)",
        "Partial Shade (2-4 hours)",
        "Full Shade (<2 hours)",
        "Artificial Light"
      ],
      "type": "string"
    },
    "tags": {
      "description": "Custom tags for filtering",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "thumbnail_url": {
      "description": "Small (~720px) copy of image_url for garden cards and lists",
      "type": "string"
    },
    "total_waterings": {
      "default": 0,
      "type": "number"
    },
    "vacation_end_date": {
      "format": "date",
      "type": "string"
    },
    "vacation_mode_enabled": {
      "default": false,
      "type": "boolean"
    },
    "vacation_start_date": {
      "format": "date",
      "type": "string"
    },
    "water_days_grow": {
      "description": "Days between waterings in the growing season (drought-tolerant plants with seasonal watering).",
      "type": "number"
    },
    "water_days_rest": {
      "description": "Days between waterings in the rest season.",
      "type": "number"
    },
    "water_frequency_days": {
      "type": "number"
    },
    "water_method": {
      "description": "How this plant gets its water. Unset = pour (normal watering).",
      "enum": [
        "pour",
        "reservoir",
        "soak",
        "mist",
        "bottom",
        "in_water"
      ],
      "type": "string"
    },
    "water_rest_season": {
      "description": "When this plant rests: winter (most) or summer (winter growers like Aeonium).",
      "enum": [
        "winter",
        "summer"
      ],
      "type": "string"
    },
    "water_season": {
      "description": "Which interval water_frequency_days currently holds.",
      "enum": [
        "grow",
        "rest"
      ],
      "type": "string"
    },
    "water_strict": {
      "description": "Finicky about watering timing: 'Even out my schedule' never moves it.",
      "type": "boolean"
    },
    "weather_hint": {
      "description": "Plus weather-smart watering: what today's weather changed for this plant (valid only when day = today)",
      "properties": {
        "day": {
          "type": "string"
        },
        "frost_low_f": {
          "type": "number"
        },
        "frost_text": {
          "type": "string"
        },
        "high_f": {
          "type": "number"
        },
        "kind": {
          "type": "string"
        },
        "prev_last_watered": {
          "type": "string"
        },
        "prev_next_due": {
          "type": "string"
        },
        "rain_in": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "name"
  ],
  "type": "object",
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}