{
  "name": "GameEvent",
  "properties": {
    "affected_plant_ids": {
      "description": "IDs of plants affected by this event",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "event_date": {
      "description": "When the event occurred",
      "format": "date",
      "type": "string"
    },
    "event_type": {
      "description": "Type of weather event",
      "enum": [
        "drought",
        "heatwave",
        "frost",
        "hurricane",
        "tornado",
        "blizzard",
        "flood"
      ],
      "type": "string"
    },
    "message": {
      "description": "Message to display to the user",
      "type": "string"
    },
    "resolved": {
      "default": false,
      "description": "Whether the user has resolved this event",
      "type": "boolean"
    }
  },
  "required": [
    "event_type",
    "event_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}