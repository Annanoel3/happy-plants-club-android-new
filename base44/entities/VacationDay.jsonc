{
  "name": "VacationDay",
  "properties": {
    "custom_instructions": {
      "description": "Custom instructions for pets, A/C, trash days, etc.",
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "type": "string"
    },
    "notes": {
      "description": "Notes for house sitter",
      "type": "string"
    },
    "plant_notes": {
      "description": "Plant-specific notes keyed by plant_id",
      "type": "object"
    },
    "start_date": {
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "start_date",
    "end_date"
  ],
  "rls": {
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}