{
  "name": "PlantConversation",
  "properties": {
    "image_url": {
      "description": "Image URL uploaded during conversation",
      "type": "string"
    },
    "messages": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "plant_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}