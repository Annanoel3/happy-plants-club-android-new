{
  "name": "SharedGarden",
  "properties": {
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "owner_email": {
      "description": "Email of the garden owner",
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "public_description": {
      "description": "Description of the garden",
      "type": "string"
    },
    "public_name": {
      "description": "Name displayed on the public garden page",
      "type": "string"
    },
    "share_token": {
      "description": "Unique token for the public link",
      "type": "string"
    }
  },
  "required": [
    "owner_email",
    "share_token"
  ],
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    },
    "update": {
      "data.owner_email": "{{user.email}}"
    }
  },
  "type": "object"
}