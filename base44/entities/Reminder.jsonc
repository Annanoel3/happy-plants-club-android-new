{
  "name": "Reminder",
  "properties": {
    "completed": {
      "default": false,
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "fire_basis": {
      "description": "Engine: fields next_fire_at was computed from, to detect edits",
      "type": "string"
    },
    "is_recurring": {
      "default": false,
      "description": "Whether this reminder repeats",
      "type": "boolean"
    },
    "last_fired_at": {
      "description": "Engine: last time this reminder fired (UTC)",
      "format": "date-time",
      "type": "string"
    },
    "next_fire_at": {
      "description": "Engine: next time this reminder pushes (UTC)",
      "format": "date-time",
      "type": "string"
    },
    "onesignal_notification_ids": {
      "description": "Legacy: OneSignal notification IDs",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "original_time_phrase": {
      "description": "User's original time phrase for editing",
      "type": "string"
    },
    "plant_id": {
      "type": "string"
    },
    "plant_name": {
      "type": "string"
    },
    "recurrence_end_date": {
      "description": "When recurring reminders should stop",
      "format": "date",
      "type": "string"
    },
    "recurrence_type": {
      "description": "How often the reminder repeats",
      "enum": [
        "daily",
        "weekly",
        "biweekly",
        "monthly",
        "every_two_hours"
      ],
      "type": "string"
    },
    "schedule_time": {
      "description": "Specific time for the notification (UTC ISO)",
      "format": "date-time",
      "type": "string"
    },
    "scheduled_for": {
      "description": "Engine: time the queued push is set for (UTC)",
      "format": "date-time",
      "type": "string"
    },
    "scheduled_notification_id": {
      "description": "Engine: queued OneSignal notification id",
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "plant_id",
    "title",
    "due_date"
  ],
  "rls": {
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}