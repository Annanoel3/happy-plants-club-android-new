{
  "name": "Reminder",
  "properties": {
    "completed": {
      "default": false,
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "is_recurring": {
      "default": false,
      "description": "Whether this reminder repeats",
      "type": "boolean"
    },
    "onesignal_notification_ids": {
      "description": "OneSignal notification IDs for this recurring reminder batch",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "original_time_phrase": {
      "description": "User's original time phrase for editing",
      "type": "string"
    },
    "plant_id": {
      "type": "string"
    },
    "plant_name": {
      "type": "string"
    },
    "recurrence_end_date": {
      "description": "When recurring reminders should stop",
      "format": "date",
      "type": "string"
    },
    "recurrence_type": {
      "description": "How often the reminder repeats",
      "enum": [
        "daily",
        "weekly",
        "biweekly",
        "monthly",
        "every_two_hours"
      ],
      "type": "string"
    },
    "schedule_time": {
      "description": "Specific time for scheduled notification (first instance)",
      "format": "date-time",
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "plant_id",
    "title",
    "due_date"
  ],
  "rls": {
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}