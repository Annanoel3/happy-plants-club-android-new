{
  "name": "Block",
  "properties": {
    "blocked_email": {
      "description": "Email of the user being blocked",
      "type": "string"
    },
    "blocker_email": {
      "description": "Email of the user doing the blocking",
      "type": "string"
    }
  },
  "required": [
    "blocker_email",
    "blocked_email"
  ],
  "rls": {
    "create": {
      "data.blocker_email": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "data.blocker_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.blocker_email": "{{user.email}}"
        },
        {
          "data.blocked_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.blocker_email": "{{user.email}}"
    }
  },
  "type": "object"
}