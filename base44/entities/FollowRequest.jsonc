{
  "name": "FollowRequest",
  "properties": {
    "requester_email": {
      "description": "Email of user requesting to follow",
      "type": "string"
    },
    "requester_handle": {
      "type": "string"
    },
    "requester_name": {
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "type": "string"
    },
    "target_email": {
      "description": "Email of user being followed",
      "type": "string"
    }
  },
  "required": [
    "requester_email",
    "target_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}