{
  "name": "FollowRequest",
  "properties": {
    "requester_email": {
      "description": "Email of user requesting to follow",
      "type": "string"
    },
    "requester_handle": {
      "type": "string"
    },
    "requester_name": {
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "type": "string"
    },
    "target_email": {
      "description": "Email of user being followed",
      "type": "string"
    }
  },
  "required": [
    "requester_email",
    "target_email"
  ],
  "rls": {
    "create": {
      "data.requester_email": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "data.requester_email": "{{user.email}}"
        },
        {
          "data.target_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.requester_email": "{{user.email}}"
        },
        {
          "data.target_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.requester_email": "{{user.email}}"
        },
        {
          "data.target_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}