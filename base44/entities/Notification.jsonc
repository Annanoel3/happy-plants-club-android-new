{
  "name": "Notification",
  "properties": {
    "comment_id": {
      "description": "Comment it's about (removed with the comment)",
      "type": "string"
    },
    "dismissed": {
      "default": false,
      "type": "boolean"
    },
    "from_user_email": {
      "description": "Old rows only. New rows store from_user_id so nobody's email reaches someone else's phone",
      "type": "string"
    },
    "from_user_handle": {
      "type": "string"
    },
    "from_user_id": {
      "description": "User id of who triggered the notification",
      "type": "string"
    },
    "from_user_name": {
      "type": "string"
    },
    "message": {
      "description": "Notification message",
      "type": "string"
    },
    "post_id": {
      "description": "Post it's about (removed with the post)",
      "type": "string"
    },
    "read": {
      "default": false,
      "type": "boolean"
    },
    "type": {
      "description": "Type of notification",
      "enum": [
        "follow_approved",
        "follow_request",
        "new_follower",
        "like",
        "comment"
      ],
      "type": "string"
    },
    "user_email": {
      "description": "Email of user who receives the notification",
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "type",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    }
  },
  "type": "object"
}