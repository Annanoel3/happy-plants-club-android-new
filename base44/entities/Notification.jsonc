{
  "name": "Notification",
  "properties": {
    "dismissed": {
      "default": false,
      "type": "boolean"
    },
    "from_user_email": {
      "description": "Email of user who triggered the notification",
      "type": "string"
    },
    "from_user_handle": {
      "type": "string"
    },
    "from_user_name": {
      "type": "string"
    },
    "message": {
      "description": "Notification message",
      "type": "string"
    },
    "read": {
      "default": false,
      "type": "boolean"
    },
    "type": {
      "description": "Type of notification",
      "enum": [
        "follow_approved",
        "follow_request",
        "like",
        "comment"
      ],
      "type": "string"
    },
    "user_email": {
      "description": "Email of user who receives the notification",
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "type",
    "message"
  ],
  "rls": {
    "create": {
      "data.from_user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    }
  },
  "type": "object"
}