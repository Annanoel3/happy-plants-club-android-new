{
  "name": "ChatMessage",
  "properties": {
    "content": {
      "type": "string"
    },
    "role": {
      "enum": [
        "user",
        "assistant"
      ],
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "role",
    "content"
  ],
  "rls": {
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}